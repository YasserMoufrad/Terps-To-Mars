{
  "name": "terps-to-mars",
  "private": true,
  "version": "0.1.0",
  "description": "Mars spacewalk planning map with robotic scouts, built on NASA data. Team-designed mission; software written with AI coding assistants (Claude Code by Anthropic) under the team's direction. See README 'Use of AI tools'.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/verify-analysis.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.21",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
